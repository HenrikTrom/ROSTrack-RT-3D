#############################################
# BUILD STEP 1 (if using GPUs with TensorRT)
#############################################
UBUNTU_IMAGE_VERSION=20.04
CUDA_VERSION=11.8.0
TENSORRT_VERSION=8.6.1.6
CUDA_ARCH_BIN=7.5
OPENCV_VERSION=4.10.0
UID=1007 # id -u
GID=1008 # id -g
TAG1=opencv-trt-dev
CMAKE_VERSION=3.27.7
CPP_OPTIMIZATIONS="-DNDEBUG -O3 -march=skylake-avx512 -mtune=skylake-avx512 -Wno-deprecated-declarations"
#############################################
# BUILD STEP 2
#############################################
BASE_IMAGE=my/$TAG1
FLIR_CAMERA_COUNT=5
FLIR_GID=1001 # getent group | grep flir 
TAG2=ros-flir-opencv-trt-dev
#############################################
# RUN TIME
#############################################
ROS_IP=*.*.*.*
ROS_MASTER_URI=*.*.*.*